# QC-and-Predictions: this repo tracks pipeline CODE only.
# Everything else in this directory (generated data, real per-dataset configs,
# legacy one-off QC-decision scripts, editor/tool cruft) is ignored by default.
*

# --- explicitly tracked files at the repo root ---
!.gitignore
!README.md
# NOTE: legacy bulk-filtering Snakefile is intentionally NOT tracked (removed from
# git, still present on disk and functional) -- superseded by workflow/, kept only
# for continuity with in-flight legacy usage.

# --- explicitly tracked directories (code) ---
!workflow/
!workflow/**

# Standalone IGVF cell-annotation report script -- sent independently of the
# QC-and-Predictions pipeline, so it lives outside workflow/ but is still code.
!igvf_cell_annotation_report/
!igvf_cell_annotation_report/**

# This repo is PUBLIC. The two lines above un-ignore everything under
# igvf_cell_annotation_report/ -- defense-in-depth re-ignore for anything that
# looks like a credentials file, however it got there. The script itself only
# ever reads IGVF_API_KEY/IGVF_SECRET_KEY from the environment and never
# writes them anywhere, but this guards against a stray local .env/credentials
# file someone drops in that folder later getting swept up by `git add -A`.
igvf_cell_annotation_report/*.env
igvf_cell_annotation_report/.env*
igvf_cell_annotation_report/*credential*
igvf_cell_annotation_report/*secret*
igvf_cell_annotation_report/*.pem
igvf_cell_annotation_report/*.key

# Real per-dataset/per-run pipeline configs and cluster metadata: never tracked,
# only the example templates are (re-included below).
workflow/config/*
!workflow/config/example_pipeline_config.yaml
!workflow/config/example_cluster_metadata.tsv

# Synapse manifests are regenerated live from Synapse each run — never tracked.
**/synapse_manifests/

# Per-dataset scE2G module glue, regenerated fresh from config every run — never tracked.
workflow/rules/generated/

# Snakemake / conda / R / Python / editor cruft that can surface inside workflow/
**/.snakemake/
**/__pycache__/
**/*.pyc
**/.ipynb_checkpoints/
**/.Rhistory
**/*.log
**/.DS_Store
